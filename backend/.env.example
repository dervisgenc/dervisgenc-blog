# Local development settings for `go run ./cmd/blog`; copy to backend/.env.
# The database is the one started by `make dev-db`.
HTTP_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
JWT_SECRET=local-development-secret-change-me-0123456789
UPLOAD_DIR=data/uploads

DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=blog
